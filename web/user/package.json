    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.18",
    "@vitejs/plugin-vue": "^5.1.4",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^9.30.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "unocss": "^0.63.6",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.10"
  }
